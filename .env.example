# Environment variables for PanganWatch
# Copy this to .env and fill in actual values

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5433
POSTGRES_USER=panganwatch_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=panganwatch

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=panganwatch_user
MONGO_PASSWORD=change_me
MONGO_DB=bronze

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# API Keys (optional)
BPS_API_KEY=

# Airflow (for docker compose)
AIRFLOW_UID=50000
# Generate with: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=change_me_generate_with_fernet_key

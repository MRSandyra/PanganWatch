{
  "description": "Model for weather alerts sent to Kafka topic `weather.alert`.\n\nFields align with the alert contract used when precipitation exceeds a\nconfigured threshold. Alerts are generated by the Kafka consumer when\nconditions in `settings.yaml` trigger.",
  "properties": {
    "event_id": {
      "description": "UUID string, required, unique",
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "description": "must be \"1.0\"",
      "title": "Schema Version",
      "type": "string"
    },
    "kode_provinsi_bps": {
      "description": "province code, required",
      "title": "Kode Provinsi Bps",
      "type": "string"
    },
    "alert_type": {
      "description": "type of alert, e.g., heavy_rain",
      "title": "Alert Type",
      "type": "string"
    },
    "alert_level": {
      "description": "severity level",
      "enum": [
        "light",
        "moderate",
        "heavy",
        "extreme"
      ],
      "title": "Alert Level",
      "type": "string"
    },
    "threshold_field": {
      "description": "field that triggered the alert",
      "title": "Threshold Field",
      "type": "string"
    },
    "threshold_value": {
      "description": "configured threshold value",
      "title": "Threshold Value",
      "type": "number"
    },
    "current_value": {
      "description": "current observed value",
      "title": "Current Value",
      "type": "number"
    },
    "observed_at": {
      "description": "observation timestamp with timezone",
      "title": "Observed At",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "alert valid until timestamp",
      "title": "Valid Until"
    },
    "recommendation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "recommendation text",
      "title": "Recommendation"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "kode_provinsi_bps",
    "alert_type",
    "alert_level",
    "threshold_field",
    "threshold_value",
    "current_value",
    "observed_at"
  ],
  "title": "WeatherAlertV1",
  "type": "object"
}